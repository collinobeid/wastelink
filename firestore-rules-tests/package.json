{
  "name": "wastelink-firestore-rules-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automated Firebase Emulator Security Rules test suite for WasteLink Module 1",
  "scripts": {
    "test": "node --test --test-concurrency=1 auth_rules.test.mjs auth_repository_integration.test.mjs",
    "test:rules": "node --test auth_rules.test.mjs",
    "test:auth": "node --test auth_repository_integration.test.mjs",
    "test:requests": "node --test waste_requests_integration.test.mjs",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-wastelink \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1"
  }
}
